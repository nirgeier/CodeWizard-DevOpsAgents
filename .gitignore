# ── Dependencies ───────────────────────────────────────────────
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pypackages/

# ── Secrets & local env (templates stay tracked) ───────────────
.env
.env.*
!.env.example
*.pem
*.key

# WhatsApp Baileys session: the account's own credentials (creds.json holds
# advSecretKey + the registered account id) plus every captured message.
# webapp/.gitignore already covers it, but that rule only applies to that one
# directory - a stale pre-rename copy of the app (webapp -> web) is exactly how
# ~5,400 of these files got staged and nearly committed. Ignored at the repo
# root, without a leading slash, so it matches at any depth.
.wa-session/

# ── Build outputs ──────────────────────────────────────────────
.next/
.next-preview/
out/
dist/
build/
*.tsbuildinfo

# ── Generated data (runtime mirrors, never source of truth) ────
# store.py / sources.py / scan_jobs.py write these at run time.
data/
agent/data/
**/data/*.json
*.ndjson
agents/config/.discovery-state.json

# ── Python tooling caches ──────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.tox/
.nox/

# ── Logs ───────────────────────────────────────────────────────
*.log
logs/

# ── Agent & editor local state ─────────────────────────────────
.opencode-memory/

# `.opencode/` is mostly machine-local state, but skills/ is source and must be
# reviewed like any other code. A bare `.opencode/` rule cannot be re-included
# from below: git never descends into an excluded directory, so the negation
# would never match anything. Ignore the entries instead of the directory, which
# keeps git walking into it and lets skills/ back in.
.opencode/*
!.opencode/skills/
.claude/
.cursor/
.idea/
.vscode/

# ── OS / editor cruft ──────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
*.bak
*.orig
*.rej

# Playwright MCP writes page snapshots/screenshots/traces here on every tool
# call. Generated output, never source.
.playwright-mcp/