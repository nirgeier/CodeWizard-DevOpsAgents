# ── Dependencies ───────────────────────────────────────────────
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pypackages/

# ── Secrets & local env (templates stay tracked) ───────────────
.env
.env.*
!.env.example
*.pem
*.key

# WhatsApp Baileys session: the account's own credentials (creds.json holds
# advSecretKey + the registered account id) plus every captured message.
# webapp/.gitignore already covers it, but that rule only applies to that one
# directory - a stale pre-rename copy of the app (webapp -> web) is exactly how
# ~5,400 of these files got staged and nearly committed. Ignored at the repo
# root, without a leading slash, so it matches at any depth.
.wa-session/

# ── Build outputs ──────────────────────────────────────────────
.next/
out/
dist/
build/
*.tsbuildinfo

# ── Generated data (runtime mirrors, never source of truth) ────
# store.py / sources.py / scan_jobs.py write these at run time.
data/
agent/data/
**/data/*.json
*.ndjson

# ── Python tooling caches ──────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.tox/
.nox/

# ── Logs ───────────────────────────────────────────────────────
*.log
logs/

# ── Agent & editor local state ─────────────────────────────────
.opencode-memory/
.opencode/
.claude/
.cursor/
.idea/
.vscode/

# ── OS / editor cruft ──────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
*.bak
*.orig
*.rej