# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Data sources (optional)
NEWSAPI_KEY=
GNEWS_API_KEY=
APIFY_API_TOKEN=
CLAY_API_KEY=
PROXYCURL_API_KEY=
OCEAN_API_KEY=
APOLLO_API_KEY=
BUILTWITH_API_KEY=

# HTTP
USER_AGENT=CodeWizard-JobsIntel/1.0
HTTP_TIMEOUT_SEC=30
HTTP_MAX_RETRIES=3
RATE_LIMIT_PER_SEC=5

# Orchestrator
CORRELATION_WINDOW_DAYS=14
TIME_DECAY_DAYS=30
MIN_OPPORTUNITY_CONFIDENCE=0.70
REQUIRE_EVIDENCE=true
REQUIRE_WHY_NOW=true
HUMAN_IN_LOOP=true

# Embeddings
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# API
PORT=8001
API_KEY=change-me

# Discord notifications (optional)
#
# Preferred: a channel webhook. Server Settings > Integrations > Webhooks >
# New Webhook > Copy URL. Posting only, no bot and no permissions to manage.
DISCORD_WEBHOOK_URL=
#
# Alternative: a bot token + channel id. Developer Portal > your app > Bot >
# Reset Token, then invite the bot to the server with the Send Messages
# permission. Ignored when DISCORD_WEBHOOK_URL is set.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# DISCORD_NOTIFY=false disables posting entirely (same as run.py --no-notify).
DISCORD_NOTIFY=true
# Only post opportunities at or above this confidence. Blank = MIN_OPPORTUNITY_CONFIDENCE.
DISCORD_MIN_CONFIDENCE=
# Cap embeds per message; Discord rejects more than 10.
DISCORD_MAX_OPPORTUNITIES=10
# true = also post when a scan finds nothing (otherwise a quiet scan is silent).
DISCORD_NOTIFY_ON_EMPTY=false
